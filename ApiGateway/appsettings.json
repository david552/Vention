{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "Vention.API",
    "Audience": "Vention.Client"
  },
  "Gateway": {
    "SharedSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/{**catch-all}"}
      },
      "api-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/{**catch-all}" },
        "MaxRequestBodySize": 52428800
      },

      "graphql-route": {
        "ClusterId": "graphqlApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql/{**catch-all}" }
      },
      "graphql-root-route": {
        "ClusterId": "graphqlApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql" }
      }
    },
    "Clusters": {
      "mainApi": {
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".Vention.Affinity"
        },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5259/" }
        }
      },
      "graphqlApi": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5260/" }
        }
      }
    }
  }
}
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "Vention.API",
    "Audience": "Vention.Client"
  },
  "Gateway": {
    "SharedSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/{**catch-all}"}
      },
      "api-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/{**catch-all}" },
        "MaxRequestBodySize": 52428800
      }
    },
    "Clusters": {
      "mainApi": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5259/" }
        }
      }
    }
  }
}
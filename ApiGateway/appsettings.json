{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Yarp": "Information",
        "OpenTelemetry": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "Properties": {
      "Application": "Vention.ApiGateway"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "Vention.API",
    "Audience": "Vention.Client"
  },
  "Gateway": {
    "SharedSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "health-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/health" }
      },
      "api-route": {
        "ClusterId": "mainApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/{**catch-all}" },
        "MaxRequestBodySize": 52428800
      },

      "graphql-route": {
        "ClusterId": "graphqlApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql/{**catch-all}" }
      },
      "graphql-root-route": {
        "ClusterId": "graphqlApi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql" }
      }
    },
    "Clusters": {
      "mainApi": {
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".Vention.Affinity"
        },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5259/" }
        }
      },
      "graphqlApi": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5260/" }
        }
      }
    }
  }
}
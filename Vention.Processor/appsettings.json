{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Warning",
        "OpenTelemetry": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "Properties": {
      "Application": "Vention.Processor"
    }
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Database=VentionDb;Username=user;Password=12345",
    "Redis": "localhost:6379"
  },
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2",
    "TimeoutSeconds": 120,
    "EmbeddingDimensions": 768

  },
  "Rag": {
    "TopK": 5,
    "ChunkSize": 1000,
    "ChunkOverlap": 200,
    "EmbeddingBatchSize": 20,
    "MaxCosineDistance": 0.50,
    "MaxContextChars": 6000,
    "SourceSnippetChars": 300
  },

  "FileStorage": {
    "RootPath": "Storage"
  }
}
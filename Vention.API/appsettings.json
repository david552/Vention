{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",


  "CryptoSettings": {
    "PasswordPepper": ""
  },
  "ConnectionStrings": {
    "PostgresConnection": "",
    "Redis": ""
  },
  "SignalR": {
    "Redis": {
      "ChannelPrefix": ""
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Vention.API",
    "Audience": "Vention.Client",
    "AccessTokenMinutes": 1440
  },

  "Gateway": {
    "SharedSecret": "",
    "UserIdHeaderName": "X-User-Id",
    "GatewaySecretHeaderName": "X-Gateway-Secret"
  },

  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },

  "FileStorage": {
    "RootPath": "Storage"
  }
}

{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "OpenTelemetry": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "Properties": {
      "Application": "Vention.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",


  "CryptoSettings": {
    "PasswordPepper": ""
  },
  "ConnectionStrings": {
    "PostgresConnection": "",
    "Redis": "localhost:6379"
  },
  "SignalR": {
    "Redis": {
      "ChannelPrefix": "Ventioin:SignalR:"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Vention.API",
    "Audience": "Vention.Client",
    "AccessTokenMinutes": 1440
  },

  "Gateway": {
    "SharedSecret": "",
    "UserIdHeaderName": "X-User-Id",
    "GatewaySecretHeaderName": "X-Gateway-Secret"
  },

  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2",
    "TimeoutSeconds": 120,
    "MaxConcurrentRequests": 1,
    "EmbeddingDimensions": 768

  },
  "Rag": {
    "TopK": 5,
    "ChunkSize": 1000,
    "ChunkOverlap": 200,
    "EmbeddingBatchSize": 20,
    "MaxCosineDistance": 0.50,
    "MaxContextChars": 6000,
    "SourceSnippetChars": 300

  },

  "FileStorage": {
    "RootPath": "Storage"
  }
}
